# Conexion a Postgres. El driver TIENE que ser +asyncpg.
# Local (docker):  postgresql+asyncpg://postgres:postgres@localhost:5432/bookstore
# Supabase:        usar la cadena del Session Pooler
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bookstore

# Tasa USD -> VES que se usa cuando la API de cambio no responde
DEFAULT_USD_RATE=750.00

# Margen de ganancia que se aplica sobre el costo
MARGIN_PERCENTAGE=40

# API de tasas de cambio
EXCHANGE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_TIMEOUT_SECONDS=5.0
